# =============================================================================
# Turizm Pazaryeri — Ortam Değişkenleri
# =============================================================================
# Bu dosyayı köke kopyalayın:  cp .env.example .env
# Aşağıdaki tüm değişkenler Zod ile doğrulanır (apps/api/src/env.ts).
# =============================================================================

# --- Database ---
# SQLite (geliştirme): file:/home/z/my-project/db/custom.db
# PostgreSQL (üretim): postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- API ---
PORT=3000
NODE_ENV="development"
API_PREFIX="/api"
CORS_ORIGIN="http://localhost:3001"

# --- JWT ---
JWT_ACCESS_SECRET="dev-access-secret-CHANGE-ME-32chars-min"
JWT_REFRESH_SECRET="dev-refresh-secret-CHANGE-ME-32chars-min"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- File Upload (S3 uyumlu) ---
# Yerel geliştirme: dosyalar /home/z/my-project/download/uploads altına yazılır
# Üretim: AWS S3 / Cloudflare R2 bilgilerini girin
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="turizm-pazaryeri-uploads"
S3_ACCESS_KEY_ID="minio-access-key"
S3_SECRET_ACCESS_KEY="minio-secret-key"
S3_USE_PATH_STYLE="true"
S3_PRESIGN_EXPIRES_SECONDS=600
# Sandbox modu: dosyaları local diske yazar (S3 client kurulmadan çalışır)
S3_LOCAL_FS_PATH="/home/z/my-project/download/uploads"
S3_PUBLIC_BASE_URL="http://localhost:3000/uploads"

# --- Password Reset ---
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_BASE_URL="http://localhost:3001/reset-password"

# --- Rate Limit ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
