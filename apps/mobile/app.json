{
  "expo": {
    "name": "Turizm Pazaryeri",
    "slug": "turizm-pazaryeri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2D52"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turizmpazaryeri.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Profil fotoğrafı eklemek için kamera erişimi gerekli.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçmek için galeri erişimi gerekli.",
        "NSLocationWhenInUseUsageDescription": "Yakınındaki turları önermek için konum erişimi gerekli."
      },
      "associatedDomains": ["applinks:turizmpazaryeri.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2D52"
      },
      "package": "com.turizmpazaryeri.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": { "scheme": "https", "host": "turizmpazaryeri.com" },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "turizmpazaryeri",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "turizm-pazaryeri"
      },
      "apiBaseUrl": "http://localhost:3000/api",
      "deepLinkHost": "turizmpazaryeri.com"
    },
    "owner": "turizm-pazaryeri"
  }
}
