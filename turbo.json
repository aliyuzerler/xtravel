{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "PORT",
    "NODE_ENV",
    "API_PREFIX",
    "CORS_ORIGIN",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL_SECONDS",
    "JWT_REFRESH_TTL_SECONDS",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_USE_PATH_STYLE",
    "S3_PRESIGN_EXPIRES_SECONDS",
    "S3_LOCAL_FS_PATH",
    "S3_PUBLIC_BASE_URL",
    "PASSWORD_RESET_TOKEN_TTL_SECONDS",
    "PASSWORD_RESET_BASE_URL",
    "RATE_LIMIT_LOGIN_PER_MINUTE",
    "RATE_LIMIT_REGISTER_PER_MINUTE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
